{
  "name": "realtweak-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --test tests/*.test.js",
    "catalog": "node scripts/build-catalog.mjs",
    "test:rules": "firebase emulators:exec --config firebase.test.json --project demo-realtweak --only firestore \"node --test tests/rules.spec.js\""
  },
  "dependencies": {
    "firebase": "^12.0.0",
    "three": "^0.180.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "firebase-tools": "^14.0.0",
    "jsdom": "^26.1.0",
    "vite": "^6.4.1"
  },
  "overrides": {
    "@grpc/grpc-js": "1.13.6"
  }
}
