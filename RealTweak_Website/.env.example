# Register a WEB app in Firebase; do not use the Android appId from the old prototype.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
# Optional App Check reCAPTCHA Enterprise site key. Enable enforcement before launch.
VITE_APPCHECK_SITE_KEY=
# Local emulator only; never enable in a deployed build.
VITE_USE_EMULATORS=false
